OPENAI_API_KEY=sk-...
TAVILY_API_KEY=tvly-...
OPENAI_MODEL=gpt-4o-mini
EVAL_MODEL=gpt-4o
# REPORT_MODEL=gpt-4o-mini
# Reasoning models (gpt-6.1-sol, o3, gpt-5 ...): low / medium / high
REASONING_EFFORT=low
SEARCH_MAX_RESULTS=3
MIN_DOMAINS=3
MIN_RESULTS_PER_SUBQ=2
MAX_LOOPS=3
MAX_CONTENT_CHARS=800
MAX_RESULTS_PER_SUBQ_IN_PROMPT=6
SEARCH_RETRIES=2
JUDGE_MODEL=gpt-4o
# Optional: LangSmith tracing
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=research-agent
